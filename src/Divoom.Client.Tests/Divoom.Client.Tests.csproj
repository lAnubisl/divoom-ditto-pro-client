<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Divoom.Client/Divoom.Client.csproj" />
    <ProjectReference Include="../Divoom.Transport.Linux/Divoom.Transport.Linux.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="fixtures/two-frame.gif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/demo.png" Link="fixtures/demo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
